# Paths used by every script: the only file to edit before running anything.
# Sourced automatically by all Slurm jobs (slurm/_env.sh) and submit scripts; without Slurm run
#     source configs/paths.env
# from the repository root first. A variable already set in the environment wins over the value here.
# Defaults = the project machine (faretra), where nothing needs to change.

# Python interpreter of the environment with requirements.txt installed.
export PYTHON="${PYTHON:-/home/icdmultimodalproject/project/.venv/bin/python}"

# Data (credentialed MIMIC access).
export MIMIC_ROOT="${MIMIC_ROOT:-/datasets/MIMIC-CXR}"                                          # files/pXX/pXXXXXXXX/sYYYYYYYY{.txt,/*.jpg}
export DATASET_DIR="${DATASET_DIR:-/datasets/MIMIC-GEN-RAG/edin_splits/mimic-iv_icd10/multimodal}" # train/validation/test.jsonl

# Pretrained models. Two options (docs/REPRODUCE.md, section 3.2):
#  (a) use already downloaded copies: absolute paths below (defaults = the copies on faretra);
#  (b) download them into this repository: run `bash setup_weights.sh` and set the three variables to ""
#      (empty = the in-repository locations pretrained/... and vendor/dinov3 that setup_weights.sh fills).
export MEDCLIP_WEIGHTS_DIR="${MEDCLIP_WEIGHTS_DIR-/home/icdmultimodalproject/project/src/task2/pretrained}"   # folder with MedCLIP pytorch_model.bin
export DINO_CHECKPOINT="${DINO_CHECKPOINT-/home/icdmultimodalproject/project/src/task2/pretrained/dinov3-vits16/dinov3_vits16_pretrain_lvd1689m-08c60483.pth}"
export DINO_SOURCE_DIR="${DINO_SOURCE_DIR-/home/icdmultimodalproject/project/src/task2/vendor/dinov3}"       # Meta's DINOv3 code

# Frozen-backbone feature cache (~70 MB, ~20 min to build on one GPU). Empty = cache/experiment01_admission_backbone_embeddings_textfix.pt
# inside this repository, built by slurm/build_cache.sbatch. To skip the build on faretra, point it to the
# project's existing cache (it is only read; build_cache.py never overwrites an existing cache without --force):
#   export CACHE_PATH=/home/icdmultimodalproject/project/src/task2/cache/experiment01_admission_backbone_embeddings_textfix.pt
export CACHE_PATH="${CACHE_PATH-}"

# Extra sbatch options for the submit scripts (partition, node, account). On faretra's cluster:
export SBATCH_ARGS="${SBATCH_ARGS---nodelist=faretra}"

# Empty values mean "use the in-repository default".
for _v in MEDCLIP_WEIGHTS_DIR DINO_CHECKPOINT DINO_SOURCE_DIR CACHE_PATH; do
  [ -n "${!_v}" ] || unset "$_v"
done
unset _v
